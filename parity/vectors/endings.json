{
  "description": "checkEnding(run,meta) and checkExitEligibility(run,meta) truth tables.",
  "wealthThreshold": 5000,
  "exitThreshold": 750,
  "checkEnding": [
    {
      "input": {
        "neurons": 0,
        "scoreEarned": 0
      },
      "expect": "flatline"
    },
    {
      "input": {
        "neurons": -1,
        "scoreEarned": 5000
      },
      "expect": "wealth"
    },
    {
      "input": {
        "neurons": 100,
        "scoreEarned": 0
      },
      "expect": null
    },
    {
      "input": {
        "neurons": 100,
        "scoreEarned": 4999
      },
      "expect": null
    },
    {
      "input": {
        "neurons": 100,
        "scoreEarned": 5000
      },
      "expect": "wealth"
    },
    {
      "input": {
        "neurons": 100,
        "scoreEarned": 5001
      },
      "expect": "wealth"
    },
    {
      "input": {
        "neurons": 1,
        "scoreEarned": 500
      },
      "expect": null
    }
  ],
  "checkExitEligibility": [
    {
      "input": {
        "lucidityCoins": 749,
        "corruptionEverUsed": false
      },
      "expect": false
    },
    {
      "input": {
        "lucidityCoins": 750,
        "corruptionEverUsed": false
      },
      "expect": true
    },
    {
      "input": {
        "lucidityCoins": 1000,
        "corruptionEverUsed": false
      },
      "expect": true
    },
    {
      "input": {
        "lucidityCoins": 1000,
        "corruptionEverUsed": true
      },
      "expect": false
    },
    {
      "input": {
        "lucidityCoins": 0,
        "corruptionEverUsed": false
      },
      "expect": false
    }
  ]
}
