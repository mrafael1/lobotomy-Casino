{
  "expo": {
    "name": "LOBOTOMY",
    "slug": "lobotomy-casino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/machine_normal.png",
    "scheme": "lobotomy",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/bg_black.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a0a2e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lobotomy.casino"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/machine_normal.png",
        "backgroundColor": "#1a0a2e"
      },
      "package": "com.lobotomy.casino"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/machine_normal.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "a4820097-b5fc-42ae-80f4-dd915c23fc97"
      }
    }
  }
}
