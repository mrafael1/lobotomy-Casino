; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="lobotomy-Casino"
config/description="Godot 4 port of the lobotomy-Casino slot machine. Rules verified against ../parity/vectors."
run/main_scene="res://scenes/start_menu_scene.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Assets="*res://autoload/assets.gd"
MetaStateStore="*res://autoload/meta_state_store.gd"
RunStateStore="*res://autoload/run_state_store.gd"
SceneNav="*res://autoload/scene_nav.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=160
window/size/viewport_height=320
window/size/window_width_override=400
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/handheld/orientation="portrait"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
; Everything outside the 160x320 canvas — the letterbox the integer stretch leaves — is
; painted the dealer bar's own dark purple (#242234, the dominant colour of its backdrop)
; instead of the default grey, so the bars read as part of the room.
environment/defaults/default_clear_color=Color(0.141, 0.133, 0.204, 1)
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
